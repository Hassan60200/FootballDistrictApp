{# templates/match/summon.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Convocation{% endblock %}

{% block body %}
    <h1 class="mb-1" style="color: #1B2A4A;">{{ match.homeClub.name }} vs {{ match.awayClub.name }}</h1>
    <p class="text-muted mb-4">{{ match.scheduledAt.toDateTimeImmutable|date('d/m/Y à H:i') }} — {{ match.competitionName }}</p>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Joueurs disponibles</h5>
                        <div>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(true)">Tout sélectionner</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="toggleAll(false)">Tout désélectionner</button>
                        </div>
                    </div>

                    <form method="post">
                        <div class="list-group mb-3" style="max-height: 400px; overflow-y: auto;">
                            {% for player in availablePlayers %}
                                <label class="list-group-item d-flex align-items-center gap-2">
                                    <input class="form-check-input player-checkbox" type="checkbox" name="playerIds[]" value="{{ player.id.toString }}">
                                    <span>
                                    {{ player.firstName }} {{ player.lastName }}
                                    <span class="badge rounded-pill ms-1" style="background-color: #8A99A8;">{{ player.position.value|capitalize }}</span>
                                </span>
                                </label>
                            {% else %}
                                <div class="list-group-item text-muted">Tous les joueurs sont déjà convoqués.</div>
                            {% endfor %}
                        </div>

                        <button type="submit" class="btn w-100" style="background-color: #1B2A4A; color: white;">
                            Convoquer la sélection
                        </button>
                    </form>

                    {% if success %}
                        <div class="alert alert-success mt-3">{{ success }}</div>
                    {% endif %}

                    {% if error %}
                        <div class="alert alert-danger mt-3">{{ error }}</div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Joueurs convoqués ({{ summonedPlayers|length }} / 14)</h5>
                    <ul class="list-group list-group-flush">
                        {% for player in summonedPlayers %}
                            <li class="list-group-item d-flex justify-content-between">
                                {{ player.firstName }} {{ player.lastName }}
                                <span class="badge rounded-pill" style="background-color: #2E8B57;">Convoqué</span>
                            </li>
                        {% else %}
                            <li class="list-group-item text-muted">Aucun joueur convoqué pour l'instant.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <script>
        function toggleAll(checked) {
            document.querySelectorAll('.player-checkbox').forEach(cb => cb.checked = checked);
        }
    </script>
{% endblock %}
