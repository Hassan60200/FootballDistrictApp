{# templates/match/summon.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Convocation{% endblock %}

{% block body %}
    <h1 class="mb-1" style="color: #1B2A4A;">{{ match.homeClub.name }} vs {{ match.awayClub.name }}</h1>
    <p class="text-muted mb-4">{{ match.scheduledAt.toDateTimeImmutable|date('d/m/Y à H:i') }} — {{ match.competitionName }}</p>

    <div class="row">
        <div class="col-md-5">
            <form method="post" class="card border-0 shadow-sm p-3">
                <label for="playerId" class="form-label">Convoquer un joueur</label>
                <select class="form-select mb-3" id="playerId" name="playerId" required>
                    <option value="" disabled selected>Choisir un joueur</option>
                    {% for player in allPlayers %}
                        <option value="{{ player.id.toString }}">{{ player.firstName }} {{ player.lastName }}</option>
                    {% endfor %}
                </select>
                <button type="submit" class="btn" style="background-color: #1B2A4A; color: white;">Convoquer</button>
            </form>

            {% if success %}
                <div class="alert alert-success mt-3">Joueur convoqué avec succès.</div>
            {% endif %}

            {% if error %}
                <div class="alert alert-danger mt-3">{{ error }}</div>
            {% endif %}
        </div>

        <div class="col-md-7">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="mb-3">Joueurs convoqués ({{ summonedPlayers|length }} / 14)</h5>
                    <ul class="list-group list-group-flush">
                        {% for player in summonedPlayers %}
                            <li class="list-group-item">{{ player.firstName }} {{ player.lastName }}</li>
                        {% else %}
                            <li class="list-group-item text-muted">Aucun joueur convoqué pour l'instant.</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
