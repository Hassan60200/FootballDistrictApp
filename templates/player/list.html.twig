{# templates/player/list.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Joueurs{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0" style="color: #1B2A4A;">Joueurs</h1>
            <p class="text-muted mb-0">{{ players|length }} joueur{{ players|length > 1 ? 's' : '' }}</p>
        </div>
        <a href="{{ path('player_web_create') }}" class="btn" style="background-color: #1B2A4A; color: white;">
            + Nouveau joueur
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead>
                <tr style="background-color: #F4F6F8;">
                    <th class="ps-4 py-3 text-uppercase small text-muted">Joueur</th>
                    <th class="py-3 text-uppercase small text-muted">Âge</th>
                    <th class="py-3 text-uppercase small text-muted">Poste</th>
                    <th class="py-3 text-uppercase small text-muted">Email</th>
                    <th class="py-3 text-uppercase small text-muted">Statut</th>
                    <th class="pe-4 py-3"></th>
                </tr>
                </thead>
                <tbody>
                {% for player in players %}
                    <tr>
                        <td class="ps-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                     style="width: 40px; height: 40px; background-color: #1B2A4A; font-size: 0.9rem;">
                                    {{ player.firstName|slice(0, 1)|upper }}{{ player.lastName|slice(0, 1)|upper }}
                                </div>
                                <div class="fw-semibold">{{ player.firstName }} {{ player.lastName }}</div>
                            </div>
                        </td>
                        <td class="py-3">{{ player.age }} ans</td>
                        <td class="py-3">
                        <span class="badge rounded-pill" style="background-color: #8A99A8; color: white; font-weight: 500;">
                            {{ player.position.value|capitalize }}
                        </span>
                        </td>
                        <td class="py-3">{{ player.email.toString }}</td>
                        <td class="py-3">
                            {% if player.active %}
                                <span class="badge rounded-pill" style="background-color: #2E8B57;">Actif</span>
                            {% else %}
                                <span class="badge rounded-pill bg-secondary">Inactif</span>
                            {% endif %}
                        </td>
                        <td class="pe-4 py-3 text-end">
                            <button class="btn btn-sm btn-outline-secondary">Gérer</button>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            Aucun joueur pour le moment.
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
